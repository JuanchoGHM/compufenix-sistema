<Window x:Class="Compufenix.UI.ClienteRapidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPUFENIX"
        Width="540" SizeToContent="Height"
        Background="{DynamicResource FondoBrush}"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource SuperficieBrush}"
                BorderBrush="{DynamicResource BordeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Margin="16"
                Padding="24,20">
            <StackPanel>
                <!-- Encabezado compacto -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                            Background="{DynamicResource HoverSuaveBrush}" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;"
                                   FontSize="20" Foreground="{StaticResource PrimarioBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Nuevo cliente" Style="{StaticResource Titulo}"/>
                        <TextBlock Text="Registra al cliente y el equipo que trae para crear su ticket."
                                   Style="{StaticResource Subtitulo}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Cliente -->
                <TextBlock Text="Datos del cliente" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextoBrush}" Margin="0,0,0,8"/>

                <TextBlock Text="Nombre completo" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtNombre" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtTelefono"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Correo" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtCorreo"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Dirección" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtDireccion" Margin="0,0,0,14"/>

                <Border Height="1" Background="{DynamicResource BordeBrush}" Margin="0,0,0,14"/>

                <!-- Equipo -->
                <TextBlock Text="Equipo que trae" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextoBrush}" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tipo (Laptop, Impresora...)" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtTipo"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Marca" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtMarca"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Modelo" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtModelo"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Número de serie" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtNumeroSerie"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="PanelError" Background="#FEF2F2" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError"
                               Foreground="#DC2626" FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar"
                            Style="{StaticResource BotonSecundario}"
                            Click="Cancelar_Click"/>
                    <Button Grid.Column="2" Content="Guardar y usar en el ticket"
                            Click="Guardar_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>