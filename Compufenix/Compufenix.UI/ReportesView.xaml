<UserControl x:Class="Compufenix.UI.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36,40,36">
            <TextBlock Text="Reportes" Style="{StaticResource Titulo}" FontSize="28"/>
            <TextBlock Text="Resumen de inventario, tickets e ingresos."
                       Style="{StaticResource Subtitulo}" Margin="0,6,0,28"/>

            <!-- ===== Inventario ===== -->
            <Border Background="{StaticResource SuperficieBrush}"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Inventario disponible" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoBrush}" Margin="0,0,0,16"/>

                    <UniformGrid Columns="2" Margin="0,0,0,20">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Productos registrados"
                                       Style="{StaticResource Subtitulo}"/>
                            <TextBlock x:Name="TxtTotalProductos" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource TextoBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Unidades totales en stock"
                                       Style="{StaticResource Subtitulo}"/>
                            <TextBlock x:Name="TxtTotalUnidades" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource TextoBrush}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Productos con stock bajo" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoBrush}" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="ListaStockBajo">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Nombre}" FontSize="13"/>
                                    <TextBlock Grid.Column="1" FontSize="13" Foreground="#EF4444">
                                        <Run Text="{Binding StockActual, Mode=OneWay}"/>
                                        <Run Text=" / mínimo "/>
                                        <Run Text="{Binding StockMinimo, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TxtSinAlertas" Text="No hay productos con stock bajo."
                               Style="{StaticResource Subtitulo}"/>
                </StackPanel>
            </Border>

            <!-- ===== Tickets por estado ===== -->
            <Border Background="{StaticResource SuperficieBrush}"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Tickets por estado" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoBrush}" Margin="0,0,0,16"/>
                    <ItemsControl x:Name="ListaEstados">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding NombreEstado}" FontSize="13"/>
                                    <Border Grid.Column="1" Background="{StaticResource HoverSuaveBrush}"
                                            CornerRadius="10" Padding="10,3">
                                        <TextBlock Text="{Binding Cantidad}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextoBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TxtSinTickets" Text="Todavía no hay tickets registrados."
                               Style="{StaticResource Subtitulo}"/>
                </StackPanel>
            </Border>

            <!-- ===== Ingresos por período ===== -->
            <Border Background="{StaticResource SuperficieBrush}"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="24">
                <StackPanel>
                    <TextBlock Text="Ingresos por período" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Desde" Style="{StaticResource Etiqueta}"/>
                            <DatePicker x:Name="FechaDesde"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hasta" Style="{StaticResource Etiqueta}"/>
                            <DatePicker x:Name="FechaHasta"/>
                        </StackPanel>
                        <Button Grid.Column="4" Content="Calcular"
                                VerticalAlignment="Bottom" Click="Calcular_Click"/>
                    </Grid>

                    <TextBlock Text="Total de ingresos" Style="{StaticResource Subtitulo}"/>
                    <TextBlock x:Name="TxtIngresos" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource PrimarioBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>