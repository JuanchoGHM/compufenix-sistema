<Window x:Class="Compufenix.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPUFENIX"
        Height="600" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FondoBrush}">
    <Grid>
        <Border Background="{StaticResource SuperficieBrush}"
                BorderBrush="{StaticResource BordeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Width="320">
                <TextBlock Text="COMPUFENIX" Style="{StaticResource Marca}"/>
                <TextBlock Text="Panel principal"
                           Style="{StaticResource Titulo}" Margin="0,6,0,0"/>
                <TextBlock Text="Comprueba que la aplicación se comunica con la base de datos."
                           Style="{StaticResource Subtitulo}" Margin="0,6,0,24"/>
                <Button Content="Probar conexión" Click="ProbarConexion_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>