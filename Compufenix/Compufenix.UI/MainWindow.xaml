<Window x:Class="Compufenix.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPUFENIX"
        Height="680" Width="1100"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FondoBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Barra lateral ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource SuperficieBrush}"
                BorderBrush="{StaticResource BordeBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="20" LastChildFill="False">

                <!-- Parte de arriba: logo y opciones -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="COMPUFENIX"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource PrimarioBrush}"
                               Margin="4,4,0,28"/>

                    <Button Content="Inicio"
                            Style="{StaticResource BotonMenu}"
                            Background="#EFF4FF"
                            Foreground="{StaticResource PrimarioBrush}"/>
                    <Button x:Name="BtnInventario" Content="Inventario"
                            Style="{StaticResource BotonMenu}" IsEnabled="False"/>
                    <Button x:Name="BtnTickets" Content="Tickets"
                            Style="{StaticResource BotonMenu}" IsEnabled="False"/>
                    <Button x:Name="BtnClientes" Content="Clientes"
                            Style="{StaticResource BotonMenu}" IsEnabled="False"/>
                    <Button x:Name="BtnReportes" Content="Reportes"
                            Style="{StaticResource BotonMenu}" IsEnabled="False"/>
                    <Button x:Name="BtnUsuarios" Content="Usuarios"
                            Style="{StaticResource BotonMenu}" IsEnabled="False"/>
                </StackPanel>

                <!-- Parte de abajo: quién está conectado -->
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="TxtNombreUsuario"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtRolUsuario"
                               Style="{StaticResource Subtitulo}"
                               Margin="0,2,0,14"/>
                    <Button Content="Cerrar sesión"
                            Style="{StaticResource BotonSecundario}"
                            Click="CerrarSesion_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Contenido ===== -->
        <Grid Grid.Column="1" Margin="48">
            <StackPanel>
                <TextBlock x:Name="TxtBienvenida" Style="{StaticResource Titulo}"/>
                <TextBlock Text="Elige un módulo en el menú lateral para empezar."
                           Style="{StaticResource Subtitulo}" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>