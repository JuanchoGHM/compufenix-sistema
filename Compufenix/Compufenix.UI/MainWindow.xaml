<Window x:Class="Compufenix.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPUFENIX"
        WindowState="Maximized"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource FondoBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== BARRA LATERAL ===== -->
        <Border Grid.Column="0" Background="{StaticResource BarraLateralBrush}">
            <DockPanel Margin="20,28,20,20" LastChildFill="False">

                <StackPanel DockPanel.Dock="Top">
                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,32">
                        <Border Width="42" Height="42" CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="COMPUFENIX" Foreground="White"
                                   FontSize="17" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- Opciones del menú -->
                    <Button x:Name="BtnInicio" Click="Inicio_Click"
                            Style="{StaticResource BotonMenuOscuro}"
                            Background="#EA580C" Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;"
                                       FontSize="16" Width="30" VerticalAlignment="Center"/>
                            <TextBlock Text="Inicio" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnInventario" Click="Inventario_Click"
                            Style="{StaticResource BotonMenuOscuro}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE719;"
                                       FontSize="16" Width="30" VerticalAlignment="Center"/>
                            <TextBlock Text="Inventario" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnTickets" Style="{StaticResource BotonMenuOscuro}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;"
                                       FontSize="16" Width="30" VerticalAlignment="Center"/>
                            <TextBlock Text="Tickets" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnClientes" Style="{StaticResource BotonMenuOscuro}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;"
                                       FontSize="16" Width="30" VerticalAlignment="Center"/>
                            <TextBlock Text="Clientes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnReportes" Style="{StaticResource BotonMenuOscuro}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;"
                                       FontSize="16" Width="30" VerticalAlignment="Center"/>
                            <TextBlock Text="Reportes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnUsuarios" Style="{StaticResource BotonMenuOscuro}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;"
                                       FontSize="16" Width="30" VerticalAlignment="Center"/>
                            <TextBlock Text="Usuarios" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Usuario conectado y cerrar sesión -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#26FFFFFF" Margin="0,0,0,16"/>
                    <TextBlock x:Name="TxtNombreUsuario"
                               Foreground="White" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtRolUsuario"
                               Foreground="#93C5FD" FontSize="12" Margin="0,2,0,14"/>
                    <Button Style="{StaticResource BotonCerrarSesion}"
                            Click="CerrarSesion_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;"
                                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cerrar sesión" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== CONTENIDO: INICIO ===== -->
        <ScrollViewer x:Name="VistaInicio" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,36,40,36">
                <TextBlock x:Name="TxtBienvenida"
                           Style="{StaticResource Titulo}" FontSize="28"/>
                <TextBlock Text="Este es el resumen de tu negocio."
                           Style="{StaticResource Subtitulo}" Margin="0,6,0,24"/>

                <!-- Tarjetas de colores -->
                <UniformGrid Columns="4" Margin="-8,0,-8,0">

                    <Border Background="{StaticResource GradIndigo}"
                            CornerRadius="16" Padding="22" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect Color="#2563EB" BlurRadius="24"
                                              ShadowDepth="8" Direction="270" Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Productos" Foreground="White"
                                           Opacity="0.85" FontSize="13"/>
                                <TextBlock x:Name="TxtProductos" Text="—" Foreground="White"
                                           FontSize="34" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE719;"
                                       FontSize="30" Foreground="White" Opacity="0.4"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource GradAmber}"
                            CornerRadius="16" Padding="22" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect Color="#D97706" BlurRadius="24"
                                              ShadowDepth="8" Direction="270" Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Stock bajo" Foreground="White"
                                           Opacity="0.9" FontSize="13"/>
                                <TextBlock x:Name="TxtStockBajo" Text="—" Foreground="White"
                                           FontSize="34" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;"
                                       FontSize="30" Foreground="White" Opacity="0.4"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource GradTeal}"
                            CornerRadius="16" Padding="22" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect Color="#EA580C" BlurRadius="24"
                                              ShadowDepth="8" Direction="270" Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Tickets abiertos" Foreground="White"
                                           Opacity="0.9" FontSize="13"/>
                                <TextBlock x:Name="TxtTicketsAbiertos" Text="—" Foreground="White"
                                           FontSize="34" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;"
                                       FontSize="30" Foreground="White" Opacity="0.4"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource GradViolet}"
                            CornerRadius="16" Padding="22" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect Color="#1E3A8A" BlurRadius="24"
                                              ShadowDepth="8" Direction="270" Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Clientes" Foreground="White"
                                           Opacity="0.85" FontSize="13"/>
                                <TextBlock x:Name="TxtClientes" Text="—" Foreground="White"
                                           FontSize="34" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;"
                                       FontSize="30" Foreground="White" Opacity="0.4"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Tarjeta de primeros pasos -->
                <Border Background="{StaticResource SuperficieBrush}"
                        BorderBrush="{StaticResource BordeBrush}"
                        BorderThickness="1" CornerRadius="16"
                        Padding="28" Margin="0,16,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="20"
                                          ShadowDepth="4" Direction="270" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Primeros pasos" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextoBrush}" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{StaticResource HoverSuaveBrush}">
                                <TextBlock Text="1" FontWeight="Bold"
                                           Foreground="{StaticResource PrimarioBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Registra tus productos y repuestos en Inventario."
                                       Foreground="{StaticResource TextoSuaveBrush}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{StaticResource HoverSuaveBrush}">
                                <TextBlock Text="2" FontWeight="Bold"
                                           Foreground="{StaticResource PrimarioBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Registra a tus clientes y los equipos que traen al taller."
                                       Foreground="{StaticResource TextoSuaveBrush}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{StaticResource HoverSuaveBrush}">
                                <TextBlock Text="3" FontWeight="Bold"
                                           Foreground="{StaticResource PrimarioBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Crea tickets de servicio y da seguimiento a cada reparación."
                                       Foreground="{StaticResource TextoSuaveBrush}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Aquí se muestran los módulos (Inventario, Tickets...) -->
        <ContentControl x:Name="VistaModulo" Grid.Column="1" Visibility="Collapsed"/>
    </Grid>
</Window>