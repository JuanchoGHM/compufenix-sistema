<Window x:Class="Compufenix.UI.FichaClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPUFENIX"
        Width="620" SizeToContent="Height" MaxHeight="700"
        Background="{DynamicResource FondoBrush}"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource SuperficieBrush}"
                BorderBrush="{DynamicResource BordeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Margin="24"
                Padding="32">
            <StackPanel>
                <Border Width="52" Height="52" CornerRadius="26"
                        Background="{DynamicResource HoverSuaveBrush}"
                        HorizontalAlignment="Left" Margin="0,0,0,20">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;"
                               FontSize="22" Foreground="{StaticResource PrimarioBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TxtNombreCliente" Style="{StaticResource Titulo}"/>
                <TextBlock x:Name="TxtDatosCliente"
                           Style="{StaticResource Subtitulo}" Margin="0,6,0,24"/>

                <!-- Formulario para agregar un equipo -->
                <TextBlock x:Name="TxtTituloFormulario" Text="Agregar equipo" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextoBrush}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tipo" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtTipo"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Marca" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtMarca"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Modelo" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtModelo"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Número de serie" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtNumeroSerie"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="PanelError" Background="#FEF2F2" CornerRadius="8"
                        Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError"
                               Foreground="#DC2626" FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                    <Button x:Name="BtnGuardarEquipo" Content="+ Agregar equipo"
                            Click="AgregarEquipo_Click"/>
                    <Button x:Name="BtnCancelarEdicion" Content="Cancelar edición"
                            Style="{StaticResource BotonSecundario}" Margin="8,0,0,0"
                            Visibility="Collapsed" Click="CancelarEdicion_Click"/>
                </StackPanel>

                <!-- Lista de equipos -->
                <TextBlock Text="Equipos registrados" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextoBrush}" Margin="0,0,0,12"/>

                <ItemsControl x:Name="ListaEquipos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource HoverSuaveBrush}"
                                    CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextoBrush}"/>
                                        <TextBlock Text="{Binding Detalle}" FontSize="12"
                                                   Foreground="{DynamicResource TextoSuaveBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="&#xE70F;"
                                                Style="{StaticResource BotonIcono}"
                                                Width="28" Height="28"
                                                ToolTip="Editar equipo"
                                                Click="EditarEquipo_Click"/>
                                        <Button Content="&#xE74D;"
                                                Style="{StaticResource BotonIcono}"
                                                Width="28" Height="28" Margin="2,0,0,0" Foreground="#DC2626"
                                                Tag="{Binding IdEquipo}"
                                                ToolTip="Eliminar equipo"
                                                Click="EliminarEquipo_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TxtSinEquipos" Text="Este cliente todavía no tiene equipos registrados."
                           Style="{StaticResource Subtitulo}"/>

                <Button Content="Cerrar" Style="{StaticResource BotonSecundario}"
                        HorizontalAlignment="Right" Margin="0,24,0,0"
                        Click="Cerrar_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>