<UserControl x:Class="Compufenix.UI.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,36,40,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título y botón -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Inventario" Style="{StaticResource Titulo}" FontSize="28"/>
                <TextBlock Text="Productos, repuestos y accesorios de COMPUFENIX."
                           Style="{StaticResource Subtitulo}" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Content="+ Nuevo producto"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="NuevoProducto_Click"/>
        </Grid>

        <!-- Buscador -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <TextBox x:Name="TxtBuscar"
                     Width="320" HorizontalAlignment="Left"
                     Padding="38,10"
                     TextChanged="TxtBuscar_TextChanged"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                       Foreground="{StaticResource TextoSuaveBrush}"
                       FontSize="14"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="14,0,0,0" IsHitTestVisible="False"/>
        </Grid>

        <!-- Tabla de productos -->
        <Border Grid.Row="2"
                Background="{StaticResource SuperficieBrush}"
                BorderBrush="{StaticResource BordeBrush}"
                BorderThickness="1" CornerRadius="16" Padding="8,8,20,8">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="20"
                                  ShadowDepth="4" Direction="270" Opacity="0.05"/>
            </Border.Effect>
            <DataGrid x:Name="TablaProductos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="56"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}"
                                         Width="2*" FontWeight="SemiBold"/>

                    <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Categoria}"
                                         Width="*" Foreground="{StaticResource TextoSuaveBrush}"/>

                    <DataGridTextColumn Header="STOCK" Binding="{Binding StockActual}" Width="90"/>
                    <DataGridTextColumn Header="MÍNIMO" Binding="{Binding StockMinimo}" Width="90"/>

                    <DataGridTemplateColumn Header="ESTADO" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstadoAlerta}" Value="True">
                                                        <Setter Property="Fill" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Normal"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextoSuaveBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstadoAlerta}" Value="True">
                                                        <Setter Property="Text" Value="Stock bajo"/>
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="PRECIO"
                                         Binding="{Binding PrecioUnitario, StringFormat={}{0:C}}"
                                         Width="130"/>

                    <DataGridTextColumn Header="INCORPORADO"
                                         Binding="{Binding FechaIncorporacion, StringFormat=dd/MM/yyyy}"
                                         Width="120" Foreground="{StaticResource TextoSuaveBrush}"/>

                    <DataGridTemplateColumn Header="" Width="130" MinWidth="130">                        
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#xE81E;" Style="{StaticResource BotonIcono}"
                                            Width="28" Height="28"
                                            ToolTip="Registrar movimiento" Click="Movimiento_Click"/>
                                    <Button Content="&#xE70F;" Style="{StaticResource BotonIcono}"
                                            Width="28" Height="28" Margin="2,0,0,0"
                                            ToolTip="Editar" Click="Editar_Click"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource BotonIcono}"
                                            Width="28" Height="28"
                                            Foreground="#DC2626" Margin="2,0,0,0"
                                            ToolTip="Eliminar" Click="Eliminar_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>