<Window x:Class="Compufenix.UI.VerTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPUFENIX"
        Width="620" SizeToContent="Height" MaxHeight="760"
        Background="{StaticResource FondoBrush}"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <!-- ===== Encabezado ===== -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="TxtTitulo" Style="{StaticResource Titulo}"/>
                    <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource Subtitulo}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border x:Name="PildoraEstado" HorizontalAlignment="Right" VerticalAlignment="Top"
                        CornerRadius="20" Padding="14,6" Background="{StaticResource HoverSuaveBrush}">
                    <TextBlock x:Name="TxtEstado" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoBrush}"/>
                </Border>
            </Grid>

            <!-- ===== Datos del cliente y equipo ===== -->
            <Border Background="{StaticResource SuperficieBrush}"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CLIENTE" Style="{StaticResource Marca}" FontSize="11"/>
                        <TextBlock x:Name="TxtCliente" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextoBrush}" Margin="0,4,0,12"/>

                        <TextBlock Text="EQUIPO" Style="{StaticResource Marca}" FontSize="11"/>
                        <TextBlock x:Name="TxtEquipo" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextoBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TÉCNICO ASIGNADO" Style="{StaticResource Marca}" FontSize="11"/>
                        <TextBlock x:Name="TxtTecnico" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextoBrush}" Margin="0,4,0,12"/>

                        <TextBlock Text="FECHA DE INGRESO" Style="{StaticResource Marca}" FontSize="11"/>
                        <TextBlock x:Name="TxtFecha" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextoBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Diagnóstico ===== -->
            <Border Background="{StaticResource SuperficieBrush}"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Diagnóstico" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoBrush}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtDiagnostico" TextWrapping="Wrap"
                               Foreground="{StaticResource TextoSuaveBrush}"/>
                </StackPanel>
            </Border>

            <!-- ===== Repuestos usados ===== -->
            <Border Background="{StaticResource SuperficieBrush}"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Repuestos utilizados" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoBrush}" Margin="0,0,0,14"/>
                    <ItemsControl x:Name="ListaRepuestos">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3"
                                                Background="{StaticResource PrimarioBrush}"
                                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Descripcion}" FontSize="13"
                                                   Foreground="{StaticResource TextoBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding FechaTexto}"
                                               FontSize="12" Foreground="{StaticResource TextoSuaveBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TxtSinRepuestos" Text="No se han usado repuestos en este ticket."
                               Style="{StaticResource Subtitulo}"/>
                </StackPanel>
            </Border>

            <!-- ===== Costo total ===== -->
            <Border Background="{StaticResource GradTeal}"
                    CornerRadius="16" Padding="24" Margin="0,0,0,20">
                <Grid>
                    <TextBlock Text="Costo total" Foreground="White" FontSize="14" Opacity="0.9"/>
                    <TextBlock x:Name="TxtCostoTotal" FontSize="24" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <Button Content="Cerrar" Style="{StaticResource BotonSecundario}"
                    HorizontalAlignment="Right" Click="Cerrar_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>