<Window x:Class="Compufenix.UI.EditarTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPUFENIX"
        Width="480" SizeToContent="Height" MaxHeight="700"
        Background="{StaticResource FondoBrush}"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="{StaticResource SuperficieBrush}"
                BorderBrush="{StaticResource BordeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Margin="24"
                Padding="32">
            <StackPanel>
                <Border Width="52" Height="52" CornerRadius="26"
                        Background="{StaticResource HoverSuaveBrush}"
                        HorizontalAlignment="Left" Margin="0,0,0,20">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;"
                               FontSize="22" Foreground="{StaticResource PrimarioBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Editar ticket" Style="{StaticResource Titulo}"/>
                <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource Subtitulo}" Margin="0,6,0,24"/>

                <TextBlock Text="Cliente" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="CmbCliente" Margin="0,0,0,16"
                          SelectionChanged="CmbCliente_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Nombre}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Equipo" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="CmbEquipo" Margin="0,0,0,16">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Descripcion}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Técnico asignado" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="CmbTecnico" Margin="0,0,0,16">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Nombre}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Estado" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="CmbEstado" Margin="0,0,0,16">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ConvertidorEstado}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Fecha de ingreso" Style="{StaticResource Etiqueta}"/>
                <DatePicker x:Name="FechaIngreso" Margin="0,0,0,16"/>

                <TextBlock Text="Diagnóstico" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtDiagnostico" Margin="0,0,0,12"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="90"/>

                <Border x:Name="PanelError" Background="#FEF2F2" CornerRadius="8"
                        Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError"
                               Foreground="#DC2626" FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar"
                            Style="{StaticResource BotonSecundario}"
                            Click="Cancelar_Click"/>
                    <Button Grid.Column="2" Content="Guardar"
                            Click="Guardar_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>