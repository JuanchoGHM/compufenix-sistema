<Window x:Class="Compufenix.UI.RegistroAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Compufenix.UI"
        Title="COMPUFENIX"
        WindowState="Maximized"
        MinWidth="900" MinHeight="680"
        Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo -->
        <local:PanelMarca Grid.Column="0"/>

        <!-- Formulario -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="360" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="CONFIGURACIÓN INICIAL" Style="{StaticResource Marca}"/>
                <TextBlock Text="Crea tu cuenta de administrador"
                           Style="{StaticResource Titulo}" Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Será el primer usuario del sistema y podrá crear a los demás."
                           Style="{StaticResource Subtitulo}" Margin="0,6,0,28"/>

                <TextBlock Text="Nombre completo" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtNombre" Margin="0,0,0,16"/>

                <TextBlock Text="Correo" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtCorreo" Margin="0,0,0,16"/>

                <TextBlock Text="Contraseña (mínimo 6 caracteres)" Style="{StaticResource Etiqueta}"/>
                <PasswordBox x:Name="TxtContrasena" Margin="0,0,0,16"/>

                <TextBlock Text="Repetir contraseña" Style="{StaticResource Etiqueta}"/>
                <PasswordBox x:Name="TxtContrasena2" Margin="0,0,0,24"/>

                <Button Content="Crear administrador" Click="Crear_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>