<Window x:Class="Compufenix.UI.RegistroAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPUFENIX"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource FondoBrush}">
    <Border Background="{StaticResource SuperficieBrush}"
            BorderBrush="{StaticResource BordeBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="24"
            Padding="32">
        <StackPanel>
            <TextBlock Text="COMPUFENIX" Style="{StaticResource Marca}"/>
            <TextBlock Text="Crear administrador"
                       Style="{StaticResource Titulo}" Margin="0,6,0,0"/>
            <TextBlock Text="Configura el primer usuario para empezar a usar el sistema."
                       Style="{StaticResource Subtitulo}" Margin="0,6,0,24"/>

            <TextBlock Text="Nombre completo" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="TxtNombre" Margin="0,0,0,16"/>

            <TextBlock Text="Correo" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="TxtCorreo" Margin="0,0,0,16"/>

            <TextBlock Text="Contraseña (mínimo 6 caracteres)" Style="{StaticResource Etiqueta}"/>
            <PasswordBox x:Name="TxtContrasena" Margin="0,0,0,16"/>

            <TextBlock Text="Repetir contraseña" Style="{StaticResource Etiqueta}"/>
            <PasswordBox x:Name="TxtContrasena2" Margin="0,0,0,24"/>

            <Button Content="Crear administrador" Click="Crear_Click"/>
        </StackPanel>
    </Border>
</Window>