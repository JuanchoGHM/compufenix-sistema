<Window x:Class="Compufenix.UI.RegistroAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Compufenix.UI"
        Title="COMPUFENIX"
        WindowState="Maximized"
        MinWidth="900" MinHeight="680"
        Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo -->
        <local:PanelMarca Grid.Column="0"/>

        <!-- Formulario (siempre en modo claro, sin importar el tema elegido) -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="360" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="CONFIGURACIÓN INICIAL" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource PrimarioBrush}"/>
                <TextBlock Text="Crea tu cuenta de administrador"
                           FontSize="24" FontWeight="SemiBold" Foreground="#0F172A"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Será el primer usuario del sistema y podrá crear a los demás."
                           FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                           Margin="0,6,0,28"/>

                <TextBlock Text="Nombre completo" FontSize="12" FontWeight="Medium"
                           Foreground="#0F172A" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtNombre" Foreground="#0F172A" BorderBrush="#E2E8F0"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Correo" FontSize="12" FontWeight="Medium"
                           Foreground="#0F172A" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtCorreo" Foreground="#0F172A" BorderBrush="#E2E8F0"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Contraseña (mínimo 6 caracteres)" FontSize="12" FontWeight="Medium"
                           Foreground="#0F172A" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <PasswordBox x:Name="TxtContrasena" Foreground="#0F172A" BorderBrush="#E2E8F0"/>
                    <TextBox x:Name="TxtContrasenaVisible" Foreground="#0F172A" BorderBrush="#E2E8F0"
                             Visibility="Collapsed"/>
                    <Button Content="&#xE7B3;" Style="{StaticResource BotonIcono}"
                            Width="28" Height="28" Foreground="#64748B"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" Click="MostrarContrasena_Click"/>
                </Grid>

                <TextBlock Text="Repetir contraseña" FontSize="12" FontWeight="Medium"
                           Foreground="#0F172A" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,24">
                    <PasswordBox x:Name="TxtContrasena2" Foreground="#0F172A" BorderBrush="#E2E8F0"/>
                    <TextBox x:Name="TxtContrasena2Visible" Foreground="#0F172A" BorderBrush="#E2E8F0"
                             Visibility="Collapsed"/>
                    <Button Content="&#xE7B3;" Style="{StaticResource BotonIcono}"
                            Width="28" Height="28" Foreground="#64748B"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" Click="MostrarContrasena2_Click"/>
                </Grid>

                <Button Content="Crear administrador" Click="Crear_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>