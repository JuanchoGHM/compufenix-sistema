<Window x:Class="Compufenix.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Compufenix.UI"
        Title="COMPUFENIX"
        WindowState="Maximized"
        MinWidth="900" MinHeight="600"
        Background="White"
        FocusManager.FocusedElement="{Binding ElementName=TxtCorreo}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo -->
        <local:PanelMarca Grid.Column="0"/>

        <!-- Formulario (siempre en modo claro, sin importar el tema elegido) -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="360" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="Bienvenido de nuevo" FontSize="24" FontWeight="SemiBold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Inicia sesión para continuar."
                           FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                           Margin="0,6,0,32"/>

                <TextBlock Text="Correo" FontSize="12" FontWeight="Medium"
                           Foreground="#0F172A" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtCorreo" Foreground="#0F172A" BorderBrush="#E2E8F0"
                         Margin="0,0,0,18"/>

                <TextBlock Text="Contraseña" FontSize="12" FontWeight="Medium"
                           Foreground="#0F172A" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="TxtContrasena" Foreground="#0F172A" BorderBrush="#E2E8F0"/>
                    <TextBox x:Name="TxtContrasenaVisible" Foreground="#0F172A" BorderBrush="#E2E8F0"
                             Visibility="Collapsed"/>
                    <Button Content="&#xE7B3;" Style="{StaticResource BotonIcono}"
                            Width="28" Height="28" Foreground="#64748B"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" Click="MostrarContrasena_Click"/>
                </Grid>

                <TextBlock x:Name="TxtError"
                           Foreground="#DC2626" FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,8"/>

                <Button Content="Entrar" IsDefault="True"
                        Click="Entrar_Click" Margin="0,16,0,0"/>

                <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Hyperlink Click="OlvideContrasena_Click" TextDecorations="None">
                        <TextBlock Text="¿Olvidaste tu contraseña?"
                                   Foreground="{StaticResource PrimarioBrush}" FontSize="13"/>
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="¿Problemas para entrar? Contacta al administrador."
                           FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,24,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>