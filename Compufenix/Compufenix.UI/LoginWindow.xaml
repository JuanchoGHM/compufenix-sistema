<Window x:Class="Compufenix.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPUFENIX"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource FondoBrush}"
        FocusManager.FocusedElement="{Binding ElementName=TxtCorreo}">
    <Border Background="{StaticResource SuperficieBrush}"
            BorderBrush="{StaticResource BordeBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="24"
            Padding="32">
        <StackPanel>
            <TextBlock Text="COMPUFENIX" Style="{StaticResource Marca}"/>
            <TextBlock Text="Iniciar sesión"
                       Style="{StaticResource Titulo}" Margin="0,6,0,0"/>
            <TextBlock Text="Ingresa tus credenciales para continuar."
                       Style="{StaticResource Subtitulo}" Margin="0,6,0,24"/>

            <TextBlock Text="Correo" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="TxtCorreo" Margin="0,0,0,16"/>

            <TextBlock Text="Contraseña" Style="{StaticResource Etiqueta}"/>
            <PasswordBox x:Name="TxtContrasena" Margin="0,0,0,12"/>

            <TextBlock x:Name="TxtError"
                       Foreground="#DC2626"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,12"/>

            <Button Content="Entrar" IsDefault="True"
                    Click="Entrar_Click" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</Window>