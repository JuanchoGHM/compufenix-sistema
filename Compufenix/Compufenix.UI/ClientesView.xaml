<UserControl x:Class="Compufenix.UI.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,36,40,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Clientes" Style="{StaticResource Titulo}" FontSize="28"/>
                <TextBlock Text="Clientes registrados y sus datos de contacto."
                           Style="{StaticResource Subtitulo}" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Content="+ Nuevo cliente"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="NuevoCliente_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <TextBox x:Name="TxtBuscar"
                     Width="320" HorizontalAlignment="Left"
                     Padding="38,10"
                     TextChanged="TxtBuscar_TextChanged"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                       Foreground="{StaticResource TextoSuaveBrush}"
                       FontSize="14"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="14,0,0,0" IsHitTestVisible="False"/>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SuperficieBrush}"
                BorderBrush="{StaticResource BordeBrush}"
                BorderThickness="1" CornerRadius="16" Padding="8,8,20,8">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="20"
                                  ShadowDepth="4" Direction="270" Opacity="0.05"/>
            </Border.Effect>
            <DataGrid x:Name="TablaClientes"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="56"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}"
                                         Width="2*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="*"/>
                    <DataGridTextColumn Header="CORREO" Binding="{Binding Correo}" Width="2*"/>
                    <DataGridTextColumn Header="DIRECCIÓN" Binding="{Binding Direccion}" Width="2*"
                                         Foreground="{StaticResource TextoSuaveBrush}"/>

                    <DataGridTemplateColumn Header="" Width="130" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#xE716;" Style="{StaticResource BotonIcono}"
                                            Width="28" Height="28"
                                            ToolTip="Ver equipos" Click="VerEquipos_Click"/>
                                    <Button Content="&#xE70F;" Style="{StaticResource BotonIcono}"
                                            Width="28" Height="28" Margin="2,0,0,0"
                                            ToolTip="Editar" Click="Editar_Click"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource BotonIcono}"
                                            Width="28" Height="28"
                                            Foreground="#DC2626" Margin="2,0,0,0"
                                            ToolTip="Eliminar" Click="Eliminar_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>