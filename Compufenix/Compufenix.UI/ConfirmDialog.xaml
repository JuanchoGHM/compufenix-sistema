<Window x:Class="Compufenix.UI.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPUFENIX"
        Width="420" SizeToContent="Height"
        Background="{StaticResource FondoBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Background="{StaticResource SuperficieBrush}"
            BorderBrush="{StaticResource BordeBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="24"
            Padding="32">
        <StackPanel>
            <Border Width="52" Height="52" CornerRadius="26"
                    Background="#FEE2E2" HorizontalAlignment="Left" Margin="0,0,0,20">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;"
                           FontSize="22" Foreground="#DC2626"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="TxtTitulo" Text="¿Estás seguro?"
                       FontSize="19" FontWeight="SemiBold"
                       Foreground="{StaticResource TextoBrush}"/>
            <TextBlock x:Name="TxtMensaje"
                       Style="{StaticResource Subtitulo}"
                       TextWrapping="Wrap" Margin="0,8,0,28"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancelar"
                        Style="{StaticResource BotonSecundario}"
                        Click="Cancelar_Click"/>
                <Button x:Name="BtnConfirmar" Grid.Column="2" Content="Eliminar"
                        Style="{StaticResource BotonPeligro}"
                        Click="Confirmar_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>