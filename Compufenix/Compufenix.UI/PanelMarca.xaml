<UserControl x:Class="Compufenix.UI.PanelMarca"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280">
    <Border Background="{StaticResource BarraLateralBrush}" ClipToBounds="True">
        <Grid>
            <!-- Círculos decorativos: proporcionales al panel -->
            <Viewbox Stretch="UniformToFill" HorizontalAlignment="Right"
                     VerticalAlignment="Top" Width="420" Height="420"
                     Margin="0,-140,-140,0" IsHitTestVisible="False">
                <Ellipse Width="420" Height="420" Fill="White" Opacity="0.05"/>
            </Viewbox>
            <Viewbox Stretch="UniformToFill" HorizontalAlignment="Left"
                     VerticalAlignment="Bottom" Width="300" Height="300"
                     Margin="-100,0,0,-100" IsHitTestVisible="False">
                <Ellipse Width="300" Height="300"
                         Fill="{StaticResource GradTeal}" Opacity="0.25"/>
            </Viewbox>

            <!-- Margen adaptable: 24 en pantallas chicas, hasta 56 en grandes -->
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Contenido central: se reduce si no cabe, nunca se agranda -->
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Width="440" Margin="16">

                        <Border Width="140" Height="140" CornerRadius="24"
                                HorizontalAlignment="Left" Margin="0,0,0,28">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="30"
                                                  ShadowDepth="10" Opacity="0.35"/>
                            </Border.Effect>
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/logo.png"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Foreground="White" FontSize="40"
                                   FontWeight="Bold" LineHeight="50"
                                   TextWrapping="Wrap">
                            <Run Text="Tu taller,"/>
                            <LineBreak/>
                            <Run Text="siempre bajo control."/>
                        </TextBlock>

                        <TextBlock Text="Inventario, reparaciones y clientes en un solo lugar."
                                   Foreground="#BFDBFE" FontSize="16"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left" Margin="0,16,0,36"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#26FFFFFF">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE719;"
                                           Foreground="White" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Inventario en tiempo real" Foreground="White"
                                       FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#26FFFFFF">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;"
                                           Foreground="White" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Tickets de servicio técnico" Foreground="White"
                                       FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#26FFFFFF">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;"
                                           Foreground="White" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Historial completo por cliente" Foreground="White"
                                       FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>

                <!-- Pie: se ajusta al ancho disponible -->
                <TextBlock Grid.Row="1"
                           Text="Sistema de Gestión de Inventario y Tickets de Servicio"
                           Foreground="#93C5FD" FontSize="12"
                           TextWrapping="Wrap" Margin="16,12,16,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>