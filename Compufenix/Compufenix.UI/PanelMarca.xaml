<UserControl x:Class="Compufenix.UI.PanelMarca"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource BarraLateralBrush}" ClipToBounds="True">
        <Grid>
            <!-- Círculos decorativos -->
            <Ellipse Width="420" Height="420" Fill="White" Opacity="0.05"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-140,-140,0"/>
            <Ellipse Width="300" Height="300" Fill="{StaticResource GradViolet}"
                     Opacity="0.35"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-100,0,0,-100"/>

            <Grid Margin="56">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="12"
                            Background="{StaticResource GradViolet}">
                        <TextBlock Text="C" Foreground="White"
                                   FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="COMPUFENIX" Foreground="White"
                               FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <!-- Mensaje central -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Foreground="White" FontSize="40"
                               FontWeight="Bold" LineHeight="50">
                        <Run Text="Tu taller,"/>
                        <LineBreak/>
                        <Run Text="siempre bajo control."/>
                    </TextBlock>
                    <TextBlock Text="Inventario, reparaciones y clientes en un solo lugar."
                               Foreground="#C7D2FE" FontSize="16"
                               TextWrapping="Wrap" MaxWidth="420"
                               HorizontalAlignment="Left" Margin="0,16,0,36"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#26FFFFFF">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE719;"
                                       Foreground="White" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Inventario en tiempo real" Foreground="White"
                                   FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#26FFFFFF">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;"
                                       Foreground="White" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Tickets de servicio técnico" Foreground="White"
                                   FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#26FFFFFF">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;"
                                       Foreground="White" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Historial completo por cliente" Foreground="White"
                                   FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Pie -->
                <TextBlock Grid.Row="2"
                           Text="Sistema de Gestión de Inventario y Tickets de Servicio"
                           Foreground="#A5B4FC" FontSize="12"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>