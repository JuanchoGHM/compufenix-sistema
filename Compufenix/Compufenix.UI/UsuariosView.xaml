<UserControl x:Class="Compufenix.UI.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,36,40,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" CornerRadius="14"
                        Background="{DynamicResource HoverSuaveBrush}" VerticalAlignment="Top">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;"
                               FontSize="22" Foreground="{StaticResource PrimarioBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Usuarios" Style="{StaticResource Titulo}" FontSize="28"/>
                    <TextBlock Text="Administradores y técnicos con acceso al sistema."
                               Style="{StaticResource Subtitulo}" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button Content="+ Nuevo usuario"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="NuevoUsuario_Click"/>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource SuperficieBrush}"
                BorderBrush="{DynamicResource BordeBrush}"
                BorderThickness="1" CornerRadius="16" Padding="8,8,20,8">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="20"
                                  ShadowDepth="4" Direction="270" Opacity="0.05"/>
            </Border.Effect>
            <DataGrid x:Name="TablaUsuarios"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="56"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}"
                                         Width="2*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="CORREO" Binding="{Binding Correo}" Width="2*"/>
                    <DataGridTextColumn Header="ROL" Binding="{Binding Rol}" Width="*"/>

                    <DataGridTemplateColumn Header="ESTADO" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="Fill" Value="#9CA3AF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Activo"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextoSuaveBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="Text" Value="Inactivo"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BotonSecundario}"
                                        Padding="12,6" Click="CambiarActivo_Click">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Desactivar"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="Text" Value="Activar"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="90" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#xE70F;" Style="{StaticResource BotonIcono}"
                                            Width="28" Height="28"
                                            ToolTip="Editar" Click="Editar_Click"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource BotonIcono}"
                                            Width="28" Height="28"
                                            Foreground="#DC2626" Margin="2,0,0,0"
                                            ToolTip="Eliminar" Click="Eliminar_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnPaginaAnterior" Content="‹ Anterior"
                        Style="{StaticResource BotonSecundario}"
                        Padding="14,8" Margin="0,0,8,0" Click="PaginaAnterior_Click"/>
                <TextBlock x:Name="TxtPagina" VerticalAlignment="Center" Margin="8,0"
                           Foreground="{DynamicResource TextoSuaveBrush}" FontSize="13"/>
                <Button x:Name="BtnPaginaSiguiente" Content="Siguiente ›"
                        Style="{StaticResource BotonSecundario}"
                        Padding="14,8" Margin="8,0,0,0" Click="PaginaSiguiente_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>