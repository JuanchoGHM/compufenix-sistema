<Window x:Class="Compufenix.UI.FichaTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPUFENIX"
        Width="600" SizeToContent="Height"
        Background="{DynamicResource FondoBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource SuperficieBrush}"
                BorderBrush="{DynamicResource BordeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Margin="16"
                Padding="24,20">
            <StackPanel>
                <!-- Encabezado compacto: icono al lado del título -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                            Background="{DynamicResource HoverSuaveBrush}" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;"
                                   FontSize="20" Foreground="{StaticResource PrimarioBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitulo" Style="{StaticResource Titulo}"/>
                        <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource Subtitulo}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Estado -->
                <TextBlock Text="Estado del ticket" Style="{StaticResource Etiqueta}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbEstado" Grid.Column="0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ConvertidorEstado}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="Guardar estado"
                            Style="{StaticResource BotonSecundario}"
                            Click="GuardarEstado_Click"/>
                </Grid>

                <TextBlock x:Name="TxtEstadoGuardado" Text="✓ Estado guardado correctamente"
                           Foreground="#16A34A" FontSize="12" Margin="0,0,0,6"
                           Visibility="Collapsed"/>

                <!-- Mano de obra -->
                <TextBlock Text="Mano de obra" Style="{StaticResource Etiqueta}" Margin="0,8,0,0"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtManoObra" Grid.Column="0"/>
                    <Button Grid.Column="2" Content="Guardar mano de obra"
                            Style="{StaticResource BotonSecundario}"
                            Click="GuardarManoObra_Click"/>
                </Grid>
                <TextBlock x:Name="TxtManoObraMensaje" FontSize="12" Margin="0,0,0,6"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <Border Height="1" Background="{DynamicResource BordeBrush}" Margin="0,10,0,14"/>

                <!-- Repuestos -->
                <TextBlock x:Name="TxtTituloRepuesto" Text="Usar un repuesto" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextoBrush}" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Producto" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CmbProducto" Grid.Row="1" Grid.Column="0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Descripcion}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Cantidad" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtCantidad" Grid.Row="1" Grid.Column="2"/>
                </Grid>

                <Border x:Name="PanelError" Background="#FEF2F2" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError"
                               Foreground="#DC2626" FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock x:Name="TxtAyudaEdicion" Visibility="Collapsed" TextWrapping="Wrap"
                           Style="{StaticResource Subtitulo}" Margin="0,0,0,10"
                           Text="Al editar, las unidades de este registro se devuelven al stock antes de aplicar el cambio."/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button x:Name="BtnGuardarRepuesto" Content="+ Usar repuesto"
                            Click="UsarRepuesto_Click"/>
                    <Button x:Name="BtnCancelarEdicion" Content="Cancelar edición"
                            Style="{StaticResource BotonSecundario}" Margin="8,0,0,0"
                            Visibility="Collapsed" Click="CancelarEdicion_Click"/>
                </StackPanel>

                <!-- Historial de repuestos (con su propio scroll si hay muchos) -->
                <TextBlock Text="Repuestos utilizados" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextoBrush}" Margin="0,0,0,8"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="110">
                    <ItemsControl x:Name="ListaRepuestos">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Descripcion}"
                                               FontSize="13" Foreground="{DynamicResource TextoBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FechaTexto}"
                                               FontSize="12" Foreground="{DynamicResource TextoSuaveBrush}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="&#xE70F;" Style="{StaticResource BotonIcono}"
                                                Width="28" Height="28"
                                                ToolTip="Editar" Click="EditarRepuesto_Click"/>
                                        <Button Content="&#xE74D;" Style="{StaticResource BotonIcono}"
                                                Width="28" Height="28" Margin="2,0,0,0"
                                                Foreground="#DC2626"
                                                ToolTip="Quitar" Click="EliminarRepuesto_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="TxtSinRepuestos" Text="Todavía no se han usado repuestos en este ticket."
                           Style="{StaticResource Subtitulo}" Margin="0,0,0,8"/>

                <Border Height="1" Background="{DynamicResource BordeBrush}" Margin="0,8,0,12"/>

                <!-- Desglose de costos -->
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Repuestos" FontSize="13"
                               Foreground="{DynamicResource TextoSuaveBrush}"/>
                    <TextBlock x:Name="TxtCostoRepuestos" FontSize="13"
                               Foreground="{DynamicResource TextoBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Mano de obra" FontSize="13"
                               Foreground="{DynamicResource TextoSuaveBrush}"/>
                    <TextBlock x:Name="TxtCostoManoObra" FontSize="13"
                               Foreground="{DynamicResource TextoBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Grid>
                    <TextBlock Text="Costo total" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextoBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCostoTotal" FontWeight="Bold" FontSize="18"
                               Foreground="{StaticResource PrimarioBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>

                <Button Content="Cerrar" Style="{StaticResource BotonSecundario}"
                        HorizontalAlignment="Right" Margin="0,16,0,0"
                        Click="Cerrar_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>