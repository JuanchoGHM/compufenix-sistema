<UserControl x:Class="Compufenix.UI.TicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,36,40,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Tickets de servicio" Style="{StaticResource Titulo}" FontSize="28"/>
                <TextBlock Text="Seguimiento de las reparaciones en curso."
                           Style="{StaticResource Subtitulo}" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Content="+ Nuevo ticket"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="NuevoTicket_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <TextBox x:Name="TxtBuscar"
                     Width="320" HorizontalAlignment="Left"
                     Padding="38,10"
                     TextChanged="TxtBuscar_TextChanged"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                       Foreground="{StaticResource TextoSuaveBrush}"
                       FontSize="14"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="14,0,0,0" IsHitTestVisible="False"/>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SuperficieBrush}"
                BorderBrush="{StaticResource BordeBrush}"
                BorderThickness="1" CornerRadius="16" Padding="8,8,20,8">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="20"
                                  ShadowDepth="4" Direction="270" Opacity="0.05"/>
            </Border.Effect>
            <DataGrid x:Name="TablaTickets"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="56"
                      Background="Transparent"
                      BorderThickness="0"
                      MouseDoubleClick="TablaTickets_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding Equipo.Cliente.Nombre}"
                                         Width="1.6*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="EQUIPO" Binding="{Binding Equipo.Tipo}" Width="*"/>
                    <DataGridTextColumn Header="TÉCNICO" Binding="{Binding Tecnico.Nombre}" Width="*"
                                         Foreground="{StaticResource TextoSuaveBrush}"/>
                    <DataGridTemplateColumn Header="ESTADO" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Estado, Converter={StaticResource ConvertidorEstado}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="INGRESO"
                                         Binding="{Binding FechaIngreso, StringFormat=dd/MM/yyyy}"
                                         Width="*" Foreground="{StaticResource TextoSuaveBrush}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>