<UserControl x:Class="Compufenix.UI.TicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,36,40,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" CornerRadius="14"
                        Background="{DynamicResource HoverSuaveBrush}" VerticalAlignment="Top">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;"
                               FontSize="22" Foreground="{StaticResource PrimarioBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Tickets de servicio" Style="{StaticResource Titulo}" FontSize="28"/>
                    <TextBlock Text="Seguimiento de las reparaciones en curso."
                               Style="{StaticResource Subtitulo}" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Exportar ▾" Style="{StaticResource BotonSecundario}"
                        Margin="0,0,8,0" Click="Exportar_Click"/>
                <Popup x:Name="MenuExportar" Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="White" BorderBrush="{DynamicResource BordeBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4" Width="160">
                        <Border.Effect>
                            <DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="4" Opacity="0.15"/>
                        </Border.Effect>
                        <StackPanel>
                            <Button Content="Exportar a Excel" Style="{StaticResource BotonMenu}"
                                    Click="ExportarExcel_Click"/>
                            <Button Content="Exportar a PDF" Style="{StaticResource BotonMenu}"
                                    Click="ExportarPdf_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button Content="+ Nuevo ticket" Click="NuevoTicket_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="TxtBuscar"
                         Padding="38,10"
                         TextChanged="TxtBuscar_TextChanged"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                           Foreground="{DynamicResource TextoSuaveBrush}"
                           FontSize="14"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="14,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <ComboBox x:Name="CmbFiltroEstado" Grid.Column="2"
                      SelectionChanged="CmbFiltroEstado_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SuperficieBrush}"
                BorderBrush="{DynamicResource BordeBrush}"
                BorderThickness="1" CornerRadius="16" Padding="8,8,20,8">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="20"
                                  ShadowDepth="4" Direction="270" Opacity="0.05"/>
            </Border.Effect>
            <DataGrid x:Name="TablaTickets"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="56"
                      Background="Transparent"
                      BorderThickness="0"
                      CanUserSortColumns="True"
                      MouseDoubleClick="TablaTickets_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding Equipo.Cliente.Nombre}"
                                         SortMemberPath="Equipo.Cliente.Nombre"
                                         Width="1.6*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="EQUIPO" Binding="{Binding Equipo.Tipo}"
                                         SortMemberPath="Equipo.Tipo" Width="*"/>
                    <DataGridTextColumn Header="TÉCNICO" Binding="{Binding Tecnico.Nombre}"
                                         SortMemberPath="Tecnico.Nombre" Width="*"
                                         Foreground="{DynamicResource TextoSuaveBrush}"/>
                    <DataGridTemplateColumn Header="ESTADO" Width="*" SortMemberPath="Estado">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Estado, Converter={StaticResource ConvertidorEstado}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="INGRESO"
                                         Binding="{Binding FechaIngreso, StringFormat=dd/MM/yyyy}"
                                         Width="*" Foreground="{DynamicResource TextoSuaveBrush}"/>

                    <DataGridTemplateColumn Header="" Width="130" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#xE890;" Style="{StaticResource BotonIcono}"
                                            Width="28" Height="28"
                                            ToolTip="Ver" Click="Ver_Click"/>
                                    <Button Content="&#xE70F;" Style="{StaticResource BotonIcono}"
                                            Width="28" Height="28" Margin="2,0,0,0"
                                            ToolTip="Editar" Click="Editar_Click"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource BotonIcono}"
                                            Width="28" Height="28"
                                            Foreground="#DC2626" Margin="2,0,0,0"
                                            ToolTip="Eliminar" Click="Eliminar_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnPaginaAnterior" Content="‹ Anterior"
                        Style="{StaticResource BotonSecundario}"
                        Padding="14,8" Margin="0,0,8,0" Click="PaginaAnterior_Click"/>
                <TextBlock x:Name="TxtPagina" VerticalAlignment="Center" Margin="8,0"
                           Foreground="{DynamicResource TextoSuaveBrush}" FontSize="13"/>
                <Button x:Name="BtnPaginaSiguiente" Content="Siguiente ›"
                        Style="{StaticResource BotonSecundario}"
                        Padding="14,8" Margin="8,0,0,0" Click="PaginaSiguiente_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>